# The site's canonical origin, without a trailing slash.
#
# Leave this unset until a custom domain is attached: Vercel injects
# VERCEL_PROJECT_PRODUCTION_URL, so canonical tags, the sitemap and Open Graph
# images all resolve correctly on the *.vercel.app URL in the meantime.
#
# Once the domain is live, set this in Vercel under
# Settings -> Environment Variables (Production only) and redeploy.
#
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
